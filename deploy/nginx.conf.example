# Reverse proxy per CdaDecisor sul dominio Quitebold.
# Sostituisci cda.quitebold.com con il sottodominio scelto e adatta i percorsi
# dei certificati (qui si presume Let's Encrypt / certbot).

server {
    listen 80;
    server_name cda.quitebold.com;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name cda.quitebold.com;

    ssl_certificate     /etc/letsencrypt/live/cda.quitebold.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cda.quitebold.com/privkey.pem;

    client_max_body_size 8m; # margine sopra il limite di 5MB per allegato dell'app

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Necessario per lo streaming di Next.js (vedi next.config.ts: X-Accel-Buffering).
        proxy_buffering off;
    }
}
