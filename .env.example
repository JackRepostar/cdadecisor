# Copia questo file in .env (sviluppo) o in /etc/cdadecisor/.env (produzione) e
# compila i valori. Nessuna variabile qui è caricata automaticamente da Prisma:
# prisma.config.ts la importa esplicitamente con "dotenv/config".

# --- Database --------------------------------------------------------------
# Sviluppo locale (Postgres via Homebrew):
DATABASE_URL="postgresql://utente@localhost:5432/cdadecisor?schema=public"
# Produzione con Supabase: sostituisci solo questa riga con la connection string
# del progetto Supabase (Project Settings -> Database -> Connection string ->
# "URI", modalità "Transaction" per l'uso con Prisma), poi esegui:
#   npx prisma migrate deploy
# Nessun'altra modifica al codice è necessaria.
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Sessioni ----------------------------------------------------------------
# Segreto per firmare il cookie di sessione. In produzione: genera un valore
# lungo e casuale, es. `openssl rand -base64 32`, e non riusarlo tra ambienti.
SESSION_SECRET="cambia-questo-valore-in-produzione"

# --- Indirizzo pubblico dell'app ---------------------------------------------
# Usato per costruire i link nelle email (magic link, richieste, verbali) e per
# la protezione CSRF dei Server Action dietro reverse proxy.
# Sviluppo:
APP_BASE_URL="http://localhost:3000"
# Produzione (dominio Quitebold):
# APP_BASE_URL="https://cda.quitebold.com"

# --- Email reale (facoltativo: senza un provider l'app resta in modalità
# "solo log/anteprima", comoda per sviluppo e collaudo) -----------------------
# Opzione A, Resend (richiede un dominio verificato via DNS):
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="CdaDecisor <notifiche@tuodominio.it>"
#
# Opzione B, SMTP (es. Gmail / Google Workspace con "password per le app", senza
# toccare i DNS). Usata solo se RESEND_API_KEY non è impostata. Gmail accetta
# come mittente solo l'indirizzo autenticato: EMAIL_FROM, se omesso, usa SMTP_USER.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="nome@tuodominio.it"
# SMTP_PASS="password-per-le-app-di-16-caratteri"
#
# In produzione, senza provider email, il link di accesso NON viene più mostrato
# a schermo (chiunque conosca un'email potrebbe entrare). Deroga temporanea
# esplicita finché il provider non è pronto; si disattiva da sola appena è
# configurato un provider:
# ALLOW_DEV_LOGIN_LINKS="true"

# --- Allegati -----------------------------------------------------------------
# Sviluppo locale: cartella persistente dove salvare i file caricati (fuori da
# /public). Ignorata se sono presenti SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY.
# STORAGE_DIR="/var/lib/cdadecisor/uploads"
#
# Produzione (Vercel, filesystem effimero): gli allegati vanno nel bucket
# Supabase Storage "attachments" (privato). Project Settings -> API per URL e
# service_role key (quest'ultima è segreta: mai esporla al client).
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Cron esterno (produzione) ------------------------------------------------
# Segreto richiesto dall'endpoint /api/cron/tick, che avvia la pubblicazione
# giornaliera delle richieste e la generazione dei verbali periodici anche
# senza visite all'app. Genera un valore casuale e usalo nel crontab del server
# (vedi deploy/README-deploy.md).
# CRON_SECRET="cambia-questo-valore"
